# Start safely in demo or local-only mode. Never commit real values.
JINWOO_MODE=demo
JINWOO_DATA_DIR=./data

# Optional cloud providers. Leave blank to keep them disabled. A configured cloud
# provider still needs per-message approval in the local chat UI.
JINWOO_CLAUDE_API_KEY=
JINWOO_CLAUDE_MODEL=
JINWOO_GLM_API_KEY=
JINWOO_GLM_BASE_URL=
JINWOO_GLM_MODEL=
JINWOO_HUGGINGFACE_API_KEY=
JINWOO_HUGGINGFACE_MODEL=

# Reserved only. A value does not enable Mem0 or memory sync: the user must
# first confirm the intended memo API and approve a future item-level sync path.
JINWOO_MEM0_API_KEY=

# Optional local providers. These should listen only on this computer.
JINWOO_OLLAMA_BASE_URL=http://127.0.0.1:11434
JINWOO_OLLAMA_MODEL=
JINWOO_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
JINWOO_LM_STUDIO_MODEL=
