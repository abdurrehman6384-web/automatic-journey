+              <p className="native-skills__selected"><b>{selectedSkillIds.length ? selectedSkillIds.length : 'Auto'}</b> {selectedSkillIds.length ? `selected: ${selectedSkillIds.join(', ')}` : 'enabled skills will be matched deterministically'}</p>
